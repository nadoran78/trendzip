#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$(dirname "$SCRIPT_DIR")")"
CHECK_SECRETS="$PROJECT_ROOT/dev/check-secrets"
TEST_MODE=all
FIXTURE_ROOT=""

usage() {
    cat <<'EOF'
Usage: ./dev/tests/check-secrets [--all|--staged-only|--help]

Creates a temporary Git repository and linked worktree to verify clean scans
and deterministic synthetic-secret detection. The project worktree and index
are never modified.
EOF
}

fail() {
    printf 'TEST ERROR: %s\n' "$1" >&2
    exit "${2:-1}"
}

cleanup() {
    if [[ -n "$FIXTURE_ROOT" && -d "$FIXTURE_ROOT" ]]; then
        rm -rf -- "$FIXTURE_ROOT"
    fi
}

trap cleanup EXIT

write_fixture_config() {
    local destination="$1"

    printf '%s\n' \
        'title = "Trendzip check-secrets integration fixture"' \
        '' \
        '[[rules]]' \
        'id = "trendzip-synthetic-secret"' \
        'description = "Deterministic synthetic secret for integration tests"' \
        'regex = "TRENDZIP_SYNTHETIC_[A-Z0-9]{16}"' \
        'keywords = ["TRENDZIP_SYNTHETIC_"]' \
        >"$destination"
}

write_synthetic_secret() {
    local destination="$1"
    local value='TRENDZIP_SYNTHETIC_0123456789ABCDEF'

    printf 'fixture=%s\n' "$value" >"$destination"
}

case "${1:-}" in
    ''|--all) TEST_MODE=all ;;
    --staged-only) TEST_MODE=staged ;;
    --help|-h)
        usage
        exit 0
        ;;
    *)
        usage >&2
        fail "Unknown option '$1'." 2
        ;;
esac

if [[ "$#" -gt 1 ]]; then
    usage >&2
    fail 'Only one test mode option can be specified.' 2
fi

FIXTURE_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/trendzip-check-secrets-test.XXXXXX")"
MAIN_REPOSITORY="$FIXTURE_ROOT/main"
LINKED_WORKTREE="$FIXTURE_ROOT/linked"

mkdir -p "$MAIN_REPOSITORY/dev"
cp "$CHECK_SECRETS" "$MAIN_REPOSITORY/dev/check-secrets"
chmod +x "$MAIN_REPOSITORY/dev/check-secrets"
write_fixture_config "$MAIN_REPOSITORY/.gitleaks.toml"
printf 'clean fixture\n' >"$MAIN_REPOSITORY/README.md"

git -C "$MAIN_REPOSITORY" init --initial-branch=develop >/dev/null
git -C "$MAIN_REPOSITORY" config user.name 'Trendzip Fixture'
git -C "$MAIN_REPOSITORY" config user.email 'fixture@example.invalid'
git -C "$MAIN_REPOSITORY" add .
git -C "$MAIN_REPOSITORY" commit -m 'test: initialize fixture' >/dev/null
git -C "$MAIN_REPOSITORY" worktree add -b codex/test-worktree "$LINKED_WORKTREE" develop >/dev/null

printf 'Checking clean staged snapshots...\n'
GITLEAKS_FORCE_DOCKER=1 "$MAIN_REPOSITORY/dev/check-secrets" --staged
GITLEAKS_FORCE_DOCKER=1 "$LINKED_WORKTREE/dev/check-secrets" --staged

printf 'Checking staged snapshot with an unstaged config removal...\n'
mv "$LINKED_WORKTREE/.gitleaks.toml" "$FIXTURE_ROOT/gitleaks.toml.unstaged"
GITLEAKS_FORCE_DOCKER=1 "$LINKED_WORKTREE/dev/check-secrets" --staged
mv "$FIXTURE_ROOT/gitleaks.toml.unstaged" "$LINKED_WORKTREE/.gitleaks.toml"

if [[ "$TEST_MODE" == all ]]; then
    printf 'Checking clean full history...\n'
    GITLEAKS_FORCE_DOCKER=1 "$MAIN_REPOSITORY/dev/check-secrets" --all
    GITLEAKS_FORCE_DOCKER=1 "$LINKED_WORKTREE/dev/check-secrets" --all
fi

write_synthetic_secret "$LINKED_WORKTREE/leak.txt"
git -C "$LINKED_WORKTREE" add leak.txt

printf 'Checking staged synthetic-secret detection...\n'
if GITLEAKS_FORCE_DOCKER=1 "$LINKED_WORKTREE/dev/check-secrets" --staged; then
    fail 'The staged synthetic secret was not detected.'
fi

if [[ "$TEST_MODE" == staged ]]; then
    printf 'Staged check-secrets integration tests passed.\n'
    exit 0
fi

git -C "$LINKED_WORKTREE" commit --no-verify -m 'test: add synthetic leak' >/dev/null

printf 'Checking linked-worktree history synthetic-secret detection...\n'
if GITLEAKS_FORCE_DOCKER=1 "$LINKED_WORKTREE/dev/check-secrets" --all; then
    fail 'The committed synthetic secret was not detected.'
fi

printf 'All check-secrets integration tests passed.\n'
