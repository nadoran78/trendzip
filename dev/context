#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
PROJECT_STATUS="$PROJECT_ROOT/docs/project-status.md"
WORK_ITEMS="$PROJECT_ROOT/docs/work-items.md"
FULL=false

usage() {
    cat <<'EOF'
Usage: ./dev/context [--full] [--help]

Shows the current project phase, active work item, upcoming work, recent
commits, and working tree state. This command never modifies repository files.
EOF
}

metadata_value() {
    local label="$1"
    sed -n "s/^- ${label}: //p" "$PROJECT_STATUS" | head -n 1
}

section_tasks() {
    local section="$1"
    awk -v section="$section" '
        $0 == "## " section { inside = 1; next }
        inside && /^## / { exit }
        inside && /^### [A-Z]+-[0-9][0-9][0-9] / {
            sub(/^### /, "")
            print
        }
    ' "$WORK_ITEMS"
}

case "${1:-}" in
    '') ;;
    --full) FULL=true ;;
    --help|-h)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

if ! "$SCRIPT_DIR/check-context" --quiet; then
    printf '\nFix the context documents, then run ./dev/context again.\n' >&2
    exit 1
fi

printf 'MZ 따라잡기 — 프로젝트 컨텍스트\n'
printf '%s\n\n' '================================'
printf '현재 상태\n'
printf '  단계: %s\n' "$(metadata_value '현재 단계')"
printf '  집중: %s\n' "$(metadata_value '현재 집중 영역')"
printf '  갱신: %s\n\n' "$(metadata_value '마지막 갱신')"

printf 'NOW\n'
while IFS= read -r task; do
    printf '  %s\n' "$task"
done < <(section_tasks NOW)

printf '\nNEXT\n'
while IFS= read -r task; do
    printf '  %s\n' "$task"
done < <(section_tasks NEXT)

printf '\n최근 커밋\n'
git -C "$PROJECT_ROOT" log --oneline -5 | sed 's/^/  /'

printf '\n작업 트리\n'
if [[ -z "$(git -C "$PROJECT_ROOT" status --short)" ]]; then
    printf '  clean\n'
else
    git -C "$PROJECT_ROOT" status --short | sed 's/^/  /'
fi

printf '\n빠른 시작\n'
printf '  현재 작업: docs/work-items.md\n'
printf '  현재 상태: docs/project-status.md\n'
printf '  비즈니스 흐름: docs/business-flow.md\n'

if [[ "$FULL" == true ]]; then
    printf '\n상세 확인\n'
    printf '  1. docs/work-items.md에서 NOW의 범위와 완료 조건을 확인합니다.\n'
    printf '  2. 흐름이 기억나지 않으면 docs/business-flow.md를 읽습니다.\n'
    printf '  3. 작업 종료 시 AGENTS.md의 맥락 갱신 규칙을 따릅니다.\n'
    printf '  4. ./dev/check-context로 문서 구조를 검사합니다.\n'
fi
