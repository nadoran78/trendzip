#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
CONFIG_FILE="$PROJECT_ROOT/.gitleaks.toml"
GITLEAKS_VERSION="8.30.1"
GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks:v$GITLEAKS_VERSION@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"
MODE=all
STAGED_SNAPSHOT=""

usage() {
    cat <<'EOF'
Usage: ./dev/check-secrets [--all|--staged|--help]

Scans the repository for secrets with Gitleaks.

Modes:
  --all     Scan the complete Git history. This is the default mode.
  --staged  Scan the complete Git index snapshot that would be committed.
  --help    Show this help.

The script uses a local Gitleaks 8.30.1 binary when available. Otherwise it
uses the pinned ghcr.io/gitleaks/gitleaks:v8.30.1 Docker image. Set
GITLEAKS_FORCE_DOCKER=1 to exercise the Docker fallback explicitly.
EOF
}

fail() {
    printf 'ERROR: %s\n' "$1" >&2
    exit "${2:-1}"
}

cleanup() {
    if [[ -n "$STAGED_SNAPSHOT" && -d "$STAGED_SNAPSHOT" ]]; then
        rm -rf -- "$STAGED_SNAPSHOT"
    fi
}

trap cleanup EXIT

local_gitleaks_is_compatible() {
    local installed_version

    if [[ "${GITLEAKS_FORCE_DOCKER:-0}" == 1 ]]; then
        return 1
    fi

    command -v gitleaks >/dev/null 2>&1 || return 1
    installed_version="$(gitleaks version 2>/dev/null)"
    installed_version="${installed_version#v}"

    if [[ "$installed_version" != "$GITLEAKS_VERSION" ]]; then
        printf 'WARN: Gitleaks %s is installed; using pinned Docker version %s instead.\n' \
            "$installed_version" "$GITLEAKS_VERSION" >&2
        return 1
    fi
}

create_staged_snapshot() {
    local snapshot_parent="${TMPDIR:-/tmp}"

    STAGED_SNAPSHOT="$(mktemp -d "$snapshot_parent/trendzip-gitleaks-staged.XXXXXX")"
    git -C "$PROJECT_ROOT" checkout-index --all --prefix="$STAGED_SNAPSHOT/"

    [[ -f "$STAGED_SNAPSHOT/.gitleaks.toml" ]] ||
        fail "The staged snapshot does not contain .gitleaks.toml."
}

resolve_git_common_dir() {
    git -C "$PROJECT_ROOT" rev-parse --path-format=absolute --git-common-dir
}

run_gitleaks_command() {
    local output
    local exit_code

    if output="$("$@" 2>&1)"; then
        exit_code=0
    else
        exit_code=$?
    fi

    if [[ -n "$output" ]]; then
        printf '%s\n' "$output"
    fi

    if [[ "$exit_code" -ne 0 ]]; then
        return "$exit_code"
    fi

    if grep -Eq 'fatal: not a git repository|ERR \[git\]|error="stderr is not empty"' <<<"$output"; then
        printf 'ERROR: Gitleaks reported an internal Git error.\n' >&2
        return 1
    fi
}

run_local_gitleaks() {
    local config_file="$CONFIG_FILE"

    if [[ "$MODE" == staged ]]; then
        config_file="$STAGED_SNAPSHOT/.gitleaks.toml"
    fi

    local arguments=(
        --config "$config_file"
        --redact
        --no-banner
        --no-color
    )

    if [[ "$MODE" == staged ]]; then
        run_gitleaks_command gitleaks dir "${arguments[@]}" "$STAGED_SNAPSHOT"
    else
        run_gitleaks_command gitleaks git "${arguments[@]}" "$PROJECT_ROOT"
    fi
}

require_docker() {
    command -v docker >/dev/null 2>&1 ||
        fail "Install Gitleaks $GITLEAKS_VERSION or Docker to scan secrets."
    docker info >/dev/null 2>&1 ||
        fail "Install Gitleaks $GITLEAKS_VERSION or start Docker to scan secrets."
}

run_docker_staged_scan() {
    local arguments=(
        dir
        --config /scan/.gitleaks.toml
        --redact
        --no-banner
        --no-color
        /scan
    )

    run_gitleaks_command docker run --rm \
        --user "$(id -u):$(id -g)" \
        --env HOME=/tmp \
        --volume "$STAGED_SNAPSHOT:/scan:ro" \
        --workdir /scan \
        "$GITLEAKS_IMAGE" \
        "${arguments[@]}"
}

run_docker_history_scan() {
    local git_common_dir
    local docker_arguments=(
        run
        --rm
        --user "$(id -u):$(id -g)"
        --env HOME=/tmp
        --volume "$PROJECT_ROOT:$PROJECT_ROOT:ro"
        --workdir "$PROJECT_ROOT"
    )
    local gitleaks_arguments=(
        git
        --config "$CONFIG_FILE"
        --redact
        --no-banner
        --no-color
        "$PROJECT_ROOT"
    )

    git_common_dir="$(resolve_git_common_dir)" ||
        fail "Unable to resolve Git common directory."
    [[ -d "$git_common_dir" ]] ||
        fail "Git common directory was not found: $git_common_dir"

    case "$git_common_dir" in
        "$PROJECT_ROOT"/*) ;;
        *) docker_arguments+=(--volume "$git_common_dir:$git_common_dir:ro") ;;
    esac

    docker_arguments+=("$GITLEAKS_IMAGE")
    run_gitleaks_command docker "${docker_arguments[@]}" "${gitleaks_arguments[@]}"
}

run_docker_gitleaks() {
    require_docker

    if [[ "$MODE" == staged ]]; then
        run_docker_staged_scan
    else
        run_docker_history_scan
    fi
}

case "${1:-}" in
    ''|--all)
        MODE=all
        ;;
    --staged)
        MODE=staged
        ;;
    --help|-h)
        usage
        exit 0
        ;;
    *)
        usage >&2
        fail "Unknown option '$1'." 2
        ;;
esac

if [[ "$#" -gt 1 ]]; then
    usage >&2
    fail "Only one mode option can be specified." 2
fi

git_worktree_state="$(
    git -C "$PROJECT_ROOT" rev-parse --is-inside-work-tree 2>/dev/null
)" || fail "Git repository was not found: $PROJECT_ROOT"
[[ "$git_worktree_state" == true ]] || fail "Not inside a Git worktree: $PROJECT_ROOT"

if [[ "$MODE" == staged ]]; then
    create_staged_snapshot
else
    [[ -f "$CONFIG_FILE" ]] || fail "Gitleaks configuration was not found: $CONFIG_FILE"
    git -C "$PROJECT_ROOT" log -1 --format=%H >/dev/null 2>&1 ||
        fail "The repository has no commits to scan."
fi

printf 'Scanning secrets with Gitleaks %s (%s)...\n' "$GITLEAKS_VERSION" "$MODE"

if local_gitleaks_is_compatible; then
    run_local_gitleaks
else
    run_docker_gitleaks
fi

printf 'Secret scan completed successfully (%s).\n' "$MODE"
