#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BACKEND_DIR="$PROJECT_ROOT/backend"
FRONTEND_DIR="$PROJECT_ROOT/frontend"
COMPOSE_FILE="$PROJECT_ROOT/docker-compose.yml"
MODE=quick

usage() {
    cat <<'EOF'
Usage: ./dev/verify [--quick|--full|--help]

Runs repository-wide verification from any working directory.

Modes:
  --quick  Context, whitespace, backend ktlint, frontend lint and typecheck.
           This is the default mode and does not require Docker.
  --full   Starts local PostgreSQL, then runs backend prepareJooq/build and
           frontend lint/typecheck/production build.
  --help   Show this help.
EOF
}

fail() {
    printf 'ERROR: %s\n' "$1" >&2
    exit "${2:-1}"
}

step() {
    printf '\n==> %s\n' "$1"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "Required command '$1' was not found."
}

check_frontend_dependencies() {
    local binary

    for binary in eslint tsc; do
        if [[ ! -x "$FRONTEND_DIR/node_modules/.bin/$binary" ]]; then
            fail "Frontend dependencies are missing. Run 'cd frontend && npm install'."
        fi
    done

    if [[ "$MODE" == full && ! -x "$FRONTEND_DIR/node_modules/.bin/next" ]]; then
        fail "Frontend dependencies are missing. Run 'cd frontend && npm install'."
    fi
}

run_context_and_diff_checks() {
    step "Checking project context"
    "$PROJECT_ROOT/dev/check-context" --strict

    step "Checking unstaged and staged diffs"
    git -C "$PROJECT_ROOT" diff --check
    git -C "$PROJECT_ROOT" diff --cached --check
}

run_frontend_fast_checks() {
    step "Running frontend lint"
    (
        cd "$FRONTEND_DIR"
        npm run lint
    )

    step "Running frontend typecheck"
    (
        cd "$FRONTEND_DIR"
        npm run typecheck
    )
}

run_quick_verification() {
    step "Running backend ktlint"
    (
        cd "$BACKEND_DIR"
        ./gradlew ktlintCheck --no-daemon
    )

    run_frontend_fast_checks
}

ensure_test_database() {
    local database_exists

    database_exists="$(
        docker compose -f "$COMPOSE_FILE" exec -T postgres \
            psql -U mztrend -d postgres -tAc \
            "SELECT 1 FROM pg_database WHERE datname = 'mztrend_test'"
    )"

    if [[ "$database_exists" != "1" ]]; then
        step "Creating local PostgreSQL test database"
        docker compose -f "$COMPOSE_FILE" exec -T postgres \
            createdb -U mztrend mztrend_test
    fi
}

run_full_verification() {
    step "Starting local PostgreSQL"
    docker compose -f "$COMPOSE_FILE" up -d --wait postgres
    ensure_test_database

    step "Running backend Flyway, jOOQ, tests and build"
    (
        cd "$BACKEND_DIR"
        ./gradlew prepareJooq build --no-daemon
    )

    run_frontend_fast_checks

    step "Running frontend production build"
    (
        cd "$FRONTEND_DIR"
        npm run build
    )
}

case "${1:-}" in
    '')
        MODE=quick
        ;;
    --quick)
        MODE=quick
        ;;
    --full)
        MODE=full
        ;;
    --help|-h)
        usage
        exit 0
        ;;
    *)
        usage >&2
        fail "Unknown option '$1'." 2
        ;;
esac

if [[ "$#" -gt 1 ]]; then
    usage >&2
    fail "Only one mode option can be specified." 2
fi

require_command git
require_command npm
[[ -x "$BACKEND_DIR/gradlew" ]] || fail "Backend Gradle wrapper is not executable."
check_frontend_dependencies

if [[ "$MODE" == full ]]; then
    require_command docker
    docker compose version >/dev/null 2>&1 ||
        fail "Docker Compose v2 is required for full verification."
fi

printf 'Trendzip verification mode: %s\n' "$MODE"
run_context_and_diff_checks

if [[ "$MODE" == quick ]]; then
    run_quick_verification
else
    run_full_verification
fi

printf '\nVerification completed successfully (%s).\n' "$MODE"
