{
  "name": "trendzip-media",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "render:sample": "node scripts/render.mjs",
    "stills:sample": "node scripts/render-stills.mjs",
    "validate:sample": "node scripts/validate-output.mjs out/made-in-korea.mp4 fixtures/made-in-korea.sample.json",
    "verify:sample": "npm run typecheck && npm test && npm run render:sample"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@remotion/cli": "4.0.512",
    "@remotion/renderer": "4.0.512",
    "ffprobe-static": "3.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.512"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.2"
  }
}
